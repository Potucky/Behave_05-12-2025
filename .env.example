# Public Sauce Demo store. These are the credentials printed on the login page.
# Copy to .env to override. Nothing here is a secret.
BASE_URL=https://www.saucedemo.com
BROWSER=chrome
HEADLESS=true
EXPLICIT_WAIT=20
PAGE_LOAD_TIMEOUT=45
WINDOW_WIDTH=1440
WINDOW_HEIGHT=1080

# Account used by scenarios that start from a signed-in shopper.
SAUCE_USERNAME=standard_user
SAUCE_PASSWORD=secret_sauce
SAUCE_LOCKED_USERNAME=locked_out_user

# Sauce Demo charges 8% tax, rounded to the cent (half up).
TAX_RATE=0.08

# Optional absolute path to Chrome. Leave empty to use Selenium Manager's default.
CHROME_BINARY=
